services:
  arcane:
    image: fnsys/arcane:a72831ab
    container_name: arcane
    restart: unless-stopped
    expose:
        - "3000"
    environment:
        FEAT_BACKUPS_ENABLED: true
        EXPORT_METRICS: true
        FEAT_API_DOCS: true
        # https://arcane.pro/manual/#volume-path-mapping
        DATA_DIR: /opt/arcane
    networks:
      - gateway
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./data:/opt/arcane
    deploy:
      resources:
        limits:
          cpus: '0.30'
          memory: 256M

networks:
  gateway:
    external: true
