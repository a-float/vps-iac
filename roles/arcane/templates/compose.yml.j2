services:
  arcane:
    image: ghcr.io/getarcaneapp/manager:latest
    container_name: arcane
    expose:
      - '3552'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - arcane-data:/app/data
      - /opt/arcane:/opt/arcane
    environment:
      APP_URL: http://arcane.mati.local
      PUID: 1000
      PGID: 1000
      ENCRYPTION_KEY: {{ arcane_encryption_key }}
      PROJECTS_DIRECTORY: /opt/arcane
    cgroup: host
    restart: unless-stopped
    networks:
      - gateway
    deploy:
      resources:
        limits:
          cpus: '0.30'
          memory: 256M

volumes:
  arcane-data:

networks:
  gateway:
    external: true
