x-common-config: &common-config
  image: "{{ nanobot_image }}"
  volumes:
    - /opt/nanobot/.nanobot:/home/nanobot/.nanobot
  cap_drop:
    - ALL
  # Entrypoint uses these to fix bind-mount ownership and drop to the nanobot user.
  cap_add:
    - CHOWN
    - SETGID
    - SETUID
  # Prevent the non-root process from regaining capabilities through setuid
  # binaries or file capabilities left inside the container image.
  security_opt:
    - no-new-privileges:true

services:
  nanobot-gateway:
    container_name: nanobot-gateway
    command: ["gateway"]
    restart: unless-stopped
    expose:
      - "8765"
    environment:
      GH_TOKEN: {{ github_token }}
    networks:
      - gateway
    deploy:
      resources:
        limits:
          memory: 300M

  nanobot-cli:
    <<: *common-config
    profiles:
      - cli
    command: ["status"]
    stdin_open: true
    tty: true


networks:
  gateway:
    external: true
