http:// {
        respond "Caddy works!"
}

http://localhost {
        respond "Local Caddy works!"
}

http://zmati.tojest.dev {
        respond "Domain Caddy works!"
}

http://{{ internal_domain }}, http://*.{{ internal_domain }} {
        @beszel host beszel.{{ internal_domain }}
        handle @beszel {
                reverse_proxy beszel:8090
        }

        @dozzle host dozzle.{{ internal_domain }}
        handle @dozzle {
                reverse_proxy dozzle:8080
        }

        @nanobot host nanobot.{{ internal_domain }}
        handle @nanobot {
                reverse_proxy nanobot-gateway:8765
        }

        @dockhand host dockhand.{{ internal_domain }}
        handle @dockhand {
                reverse_proxy dockhand:3000
        }

        @static host static.{{ internal_domain }}
        handle @static {
                root /srv/static
                file_server {
                        browse
                        precompressed gzip zstd
                }
                header {
                        Cache-Control "public, max-age=31536000, immutable"
                        -Server
                }
        }

        root /srv/internal
        file_server
}
