services:
  caddy:
    image: caddy:2
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - ./caddy/conf:/etc/caddy
      - ./caddy/site:/srv
      - ./caddy/data:/data
      - ./caddy/config:/config
    networks:
      - gateway
    deploy:
      resources:
        limits:
          cpus: '0.50'
          memory: 512M

  dnsmasq:
    image: dockurr/dnsmasq
    container_name: dnsmasq
    ports:
      - 53:53/udp
      - 53:53/tcp
    restart: unless-stopped
    volumes:
      - ./dnsmasq.d/:/etc/dnsmasq.d/
    deploy:
      resources:
        limits:
          cpus: '0.10'
          memory: 128M

networks:
  gateway:
    external: true
