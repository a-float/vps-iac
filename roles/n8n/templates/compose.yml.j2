services:
  n8n:
    image: docker.n8n.io/n8nio/n8n:latest
    container_name: n8n
    restart: unless-stopped
    expose:
      - "5678"
    environment:
      TZ: Europe/Warsaw
      GENERIC_TIMEZONE: Europe/Warsaw
      N8N_SECURE_COOKIE: false
      N8N_HOST: {{ 'n8n.' ~ internal_domain }}
      N8N_PROTOCOL: http
    volumes:
      - /opt/n8n/.n8n:/home/node/.n8n
    networks:
      - gateway

networks:
  gateway:
    external: true
