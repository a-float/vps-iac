services:
  beszel:
    image: henrygd/beszel:latest
    container_name: beszel
    restart: unless-stopped
    environment:
      APP_URL: {{ 'http://beszel.' ~ internal_domain }}
    expose:
      - "8090"
    volumes:
      - ./beszel/data:/beszel_data
      - ./beszel/socket:/beszel_socket
    networks:
      - gateway
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 64M

  beszel-agent:
    image: henrygd/beszel-agent:latest
    container_name: beszel-agent
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./beszel/agent-data:/var/lib/beszel-agent
      - ./beszel/socket:/beszel_socket
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      LISTEN: /beszel_socket/beszel.sock
      TOKEN: {{ beszel_token }}
      KEY: {{ beszel_key }}
    deploy:
      resources:
        limits:
          cpus: '0.10'
          memory: 16M

  dozzle:
    image: amir20/dozzle:latest
    container_name: dozzle
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./dozzle/data:/data
    expose:
      - "8080"
    environment:
      DOZZLE_HOSTNAME: my-vps
    networks:
      - gateway
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 64M

networks:
  gateway:
    external: true
